<configuration>

  <appSettings>
    <add key="DJANGO_SETTINGS_MODULE" value="medstock_project.settings" />
    <add key="WSGI_HANDLER" value="medstock_project.wsgi.application" />
    <add key="PYTHONPATH" value="C:\medstock\backend" />
    <add key="WSGI_LOG" value="C:\medstock\backend\wfastcgi.log" />
  </appSettings>

  <system.webServer>

    <!-- HANDLERS -->
    <handlers>
        <add name="DjangoHandler"
            path="*"
            verb="*"
            modules="FastCgiModule"
            scriptProcessor="C:\Users\Administrateur.WIN-5N8ENHT2881\AppData\Local\Programs\Python\Python312\python.exe|C:\Users\Administrateur.WIN-5N8ENHT2881\AppData\Local\Programs\Python\Python312\Lib\site-packages\wfastcgi.py"
            resourceType="Unspecified" />
    </handlers>

    <!-- FASTCGI CONFIG (MISSING BEFORE) -->
    <fastCgi>
      <application fullPath="C:\Users\Administrateur.WIN-5N8ENHT2881\AppData\Local\Programs\Python\Python312\python.exe"
                   arguments="C:\Users\Administrateur.WIN-5N8ENHT2881\AppData\Local\Programs\Python\Python312\Lib\site-packages\wfastcgi.py">
        <environmentVariables>
          <environmentVariable name="DJANGO_SETTINGS_MODULE" value="medstock_project.settings" />
          <environmentVariable name="WSGI_HANDLER" value="medstock_project.wsgi.application" />
          <environmentVariable name="PYTHONPATH" value="C:\medstock\backend" />
        </environmentVariables>
      </application>
    </fastCgi>



    <httpErrors errorMode="Detailed" />

  </system.webServer>

</configuration>